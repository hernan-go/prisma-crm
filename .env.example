NODE_ENV=development
PORT=3001
# Optional. Defaults to loopback locally and 0.0.0.0 in production.
# HOST=127.0.0.1
APP_URL=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prisma
DB_USER=prisma
DB_PASSWORD=
DB_SSL=false
TRUST_PROXY=0
# Generate with npm run auth:configure. Never put a plaintext password here.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# Optional read-only service integration. Empty values disable it (503).
# Store SHA-256 of a cryptographically random 32-byte token, encoded as 64 hex characters.
AI_READ_TOKEN_SHA256=
# HTTPS origin only; no trailing slash. Does not replace APP_URL or TRUST_PROXY.
AI_READ_PUBLIC_ORIGIN=
# Exact proxy peer IPs only, comma separated. Proxy must overwrite X-Forwarded-Proto.
AI_READ_TRUSTED_PROXY_IPS=
# Default: real TLS or an explicitly trusted proxy IP. Unknown/empty modes fail closed.
AI_READ_TRANSPORT_MODE=verified_peer
# Optional siteground_managed requires production, exact HTTPS origin/Host/XFP,
# and an absent peer or an explicitly listed IP. Assumes hosting proxy isolation.
# It does not enable access without AI_READ_TOKEN_SHA256. No auto-detection.
# Explicit loopback-only HTTP exception; ignored in production.
AI_READ_ALLOW_LOCAL_HTTP=false
# Temporary private-file probe on an already authenticated /api/auth/session request.
# Off by default; max 12 records during the first 10 minutes after app creation.
PROXY_DIAGNOSTICS=false
# Required explicit absolute directory, outside app/web roots. Existing Linux
# owner-only directory (0700); files 0600. Missing/unsafe => no diagnostic writes.
PROXY_DIAGNOSTICS_DIR=
