NODE_ENV=development
PORT=3001
# Optional. Defaults to loopback locally and 0.0.0.0 in production.
# HOST=127.0.0.1
APP_URL=http://localhost:5173
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=prisma
DB_USER=prisma
DB_PASSWORD=
DB_SSL=false
TRUST_PROXY=0
# Generate with npm run auth:configure. Never put a plaintext password here.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
